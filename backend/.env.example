MONGODB_URI=your_mongodb_atlas_connection_string
DATABASE_NAME=neerus
COLLECTION_NAME=inventory
# Low-stock limits: total across all stores, and for a single store
LOW_STOCK_THRESHOLD=20
LOW_STOCK_THRESHOLD_PER_STORE=3
# Browser origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
# Secret needed for create/update/delete (send as X-API-Key). Leave empty to disable writes.
WRITE_API_KEY=
